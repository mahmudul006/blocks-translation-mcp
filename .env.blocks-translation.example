# Blocks Translation MCP — per-project config.
# Copy this to `.env.blocks-translation` at YOUR project's repo root and fill it in.
# This file is read lazily, only when a blocks-* tool is actually invoked.

# --- connection / auth ---
BLOCKS_TENANT_ID=your-tenant-guid-here        # required
BLOCKS_PORTAL_KEY=your-portal-app-key-here    # required for login / modules / languages
BLOCKS_USERNAME=you@example.com
BLOCKS_PASSWORD=your-password
BLOCKS_BASE_URL=https://api.seliseblocks.com  # optional; this is the default
# Origin/Referer the admin surface requires. Override only for a non-cloud Blocks deployment.
BLOCKS_ORIGIN=https://cloud.seliseblocks.com  # optional; this is the default

# --- key extraction ---
# ngx-translate | react-i18next | generic
BLOCKS_FRAMEWORK=ngx-translate
# Only when BLOCKS_FRAMEWORK=generic: a regex whose first capture group is the key.
BLOCKS_KEY_REGEX=
# {module} is replaced with the resolved module name.
BLOCKS_OUTPUT_PATH_PATTERN=blocks-translation-helper/blocks-upload.{module}.generated.json

# --- optional ---
# Comma-separated extra modules always dedup-checked (defaults to: root,generic-app)
BLOCKS_DEDUP_MODULES=
# Only needed if your MCP client does NOT spawn the server with cwd = your repo root.
BLOCKS_PROJECT_ROOT=
