{
  "name": "blocks-translation-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that generates Blocks/UILM portal upload JSON from already-translated keys, with live dedup checks against the Blocks API.",
  "main": "dist/index.js",
  "bin": {
    "blocks-translation-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.blocks-translation.example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmudul006/blocks-translation-mcp.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "install-mcp": "node dist/cli.js install",
    "manual-test": "tsx src/manual-test.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
