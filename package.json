{
  "name": "blocks-translation-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that generates Blocks/UILM portal upload JSON from already-translated keys, with live dedup checks against the Blocks API.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "manual-test": "tsx src/manual-test.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
